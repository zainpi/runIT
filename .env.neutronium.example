# Server/runtime configuration. Never put secrets in NEXT_PUBLIC variables.
NEUTRONIUM_DATABASE_URL=postgres://neutronium:CHANGE_ME@localhost:5432/neutronium
# Docker Compose uses this password to construct its internal database URL.
NEUTRONIUM_POSTGRES_PASSWORD=
NEUTRONIUM_DOMAIN=neutronium.example.com
NEUTRONIUM_APP_URL=https://neutronium.example.com
NEUTRONIUM_MICROSOFT_CLIENT_ID=
NEUTRONIUM_MICROSOFT_CLIENT_SECRET=
NEUTRONIUM_ACTIVE_KEY_VERSION=v1
NEUTRONIUM_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
NEUTRONIUM_CRON_SECRET=
NEUTRONIUM_EMAIL_API_KEY=
NEUTRONIUM_EMAIL_FROM=
# cloudflare_smtp uses smtp.mx.cloudflare.net:465 with literal username api_token.
# Leave provider as resend when using the legacy Resend API key above.
NEUTRONIUM_EMAIL_PROVIDER=cloudflare_smtp
NEUTRONIUM_EMAIL_SMTP_PASSWORD=
# Local demo is enabled only under NODE_ENV=development.
NEUTRONIUM_DISABLE_DEMO=false

# Social sign-in: separate app registrations from directory provisioning.
NEUTRONIUM_GOOGLE_LOGIN_CLIENT_ID=
NEUTRONIUM_GOOGLE_LOGIN_CLIENT_SECRET=
NEUTRONIUM_MICROSOFT_LOGIN_CLIENT_ID=
NEUTRONIUM_MICROSOFT_LOGIN_CLIENT_SECRET=
# This version supports one configured Microsoft sign-in tenant.
NEUTRONIUM_MICROSOFT_LOGIN_TENANT_ID=
