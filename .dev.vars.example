PULSEDEALS_SUPABASE_URL=https://mjagaepkilhbmpfdsduw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PULSEDEALS_SESSION_SECRET=
PULSEDEALS_CRON_SECRET=
# Shared only with KeepaBot; use at least 32 random bytes.
PULSEDEALS_INGEST_SECRET=
KEEPA_API_KEY=
PULSEDEALS_APPLE_ID=
PULSEDEALS_BUNDLE_ID=com.pulsedeals.app
PULSEDEALS_PRODUCT_ID=com.pulsedeals.subscription.weekly
# Optional Apple review account. The API creates this account lazily with an active Pro
# entitlement when the configured credentials are used; keep both values server-side only.
# PULSEDEALS_REVIEW_USERNAME=
# PULSEDEALS_REVIEW_PASSWORD=
# PULSEDEALS_REVIEW_PRODUCT_ID=com.pulsedeals.subscription.pro.weekly
# Optional: base64-encoded AppleRootCA-G3.cer
APPLE_ROOT_CA_G3_BASE64=

# Optional Discord community access. The bot must already be in the target guild and the role
# must be a subscriber-only role managed by that bot.
PULSEDEALS_DISCORD_CLIENT_ID=
PULSEDEALS_DISCORD_CLIENT_SECRET=
PULSEDEALS_DISCORD_BOT_TOKEN=
PULSEDEALS_DISCORD_GUILD_ID=
PULSEDEALS_DISCORD_ROLE_ID=
# Separate roles supplied by your paid Discord membership provider; never the app access role.
PULSEDEALS_DISCORD_PAID_ROLE_ID=
PULSEDEALS_DISCORD_PRO_ROLE_ID=
PULSEDEALS_DISCORD_REDIRECT_URI=https://runsit.ca/pulsedeals/api/v1/discord/callback
PULSEDEALS_DISCORD_APP_CALLBACK=pulsedeals://discord/callback
PULSEDEALS_DISCORD_SERVER_NAME=PulseDeals
# Referral program: configure Apple offers and secrets before setting true.
PULSEDEALS_REFERRALS_ENABLED=false
PULSEDEALS_REFERRAL_ENVIRONMENT=Production
# PULSEDEALS_APPLE_OFFER_KEY_ID=
# PULSEDEALS_APPLE_OFFER_PRIVATE_KEY= (server-only App Store Connect In-App Purchase .p8)
# PULSEDEALS_APPLE_ISSUER_ID=

# Contact form (runsit.ca/contact/). Messages are sent through Resend's email API; until both
# values are set, the form tells visitors to email info@runs-it.com instead. The sender must use
# a domain verified in Resend. CONTACT_TO_EMAIL defaults to info@runs-it.com.
CONTACT_RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=

# Google Analytics 4 is a build-time variable (NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX) set in the
# build environment, not here. It loads only after a visitor accepts analytics cookies.
