# Server-only. Prefer a Stripe restricted key with the permissions documented
# in docs/ai-templates.md. Enter values in ignored .env.local for local Next.
# For Cloudflare, use protected runtime secrets (never NEXT_PUBLIC_ variables).
TEMPLATES_STRIPE_KEY=
TEMPLATES_STRIPE_WEBHOOK_SECRET=
TEMPLATES_SITE_URL=https://runsit.ca

# AI tailoring uses OpenAI Responses and the TEMPLATES_AI_ORDERS Durable Object.
# Keep disabled until the binding, model and protected API key are configured.
TEMPLATES_AI_ENABLED=false
TEMPLATES_AI_MODEL=gpt-5.6-luna
TEMPLATES_AI_REASONING_EFFORT=max
TEMPLATES_OPENAI_API_KEY=

# Allow new redemptions of the 50-use trial code (existing trial links still work when false).
TEMPLATES_TRIAL_ENABLED=false

# Optional $5 app icon add-on: initial image plus 3 updates. Shares the key and order binding above.
TEMPLATES_ICON_ENABLED=false
TEMPLATES_ICON_MODEL=gpt-image-2.5-flare-2026-09-08
