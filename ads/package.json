{
  "name": "runsit-ads",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical video ads for runsIT AI templates: Higgsfield clips + product footage composed with Remotion.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "clips:check": "NODE_USE_ENV_PROXY=1 node scripts/clips.mjs check",
    "clips:generate": "NODE_USE_ENV_PROXY=1 node scripts/clips.mjs generate",
    "footage": "cd .. && npx tsx ads/scripts/record-product.mts",
    "music": "python3 scripts/make-music.py public/music/idea-pulse.wav",
    "render": "remotion render src/index.ts NotesAppIdeas out/notes-app-ideas.mp4",
    "render:no-music": "remotion render src/index.ts NotesAppIdeas out/notes-app-ideas-no-music.mp4 --props='{\"music\":false}'",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.mjs",
    "stills": "remotion still src/index.ts NotesAppIdeas out/poster.png --frame=170",
    "render:all": "npm run render && npm run render:no-music && npm run stills",
    "voiceover": "python3 scripts/make-voiceover.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.528",
    "remotion": "4.0.528",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
