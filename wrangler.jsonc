{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker selected by the Cloudflare Workers Build.
  "name": "runsit-ca",
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service MUST equal "name" above, or deploy fails with error 10143.
      "service": "runsit-ca"
    }
  ],
  // Enable Next.js <Image> optimization on Cloudflare.
  "images": {
    "binding": "IMAGES"
  },
  // Custom domains and routes are managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
