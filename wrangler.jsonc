{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker selected by the Cloudflare Workers Build.
  "name": "runsit-ca",
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [{
    "binding": "LOCAL_LORE_DB",
    "database_name": "local-lore",
    "database_id": "125038bb-ee87-415a-aa6a-f2d73ce93873",
    "migrations_dir": "migrations/local-lore"
  }],
  "vars": { "LOCAL_LORE_IMAGE_DAILY_LIMIT": "250" },
  // Enable Next.js <Image> optimization on Cloudflare.
  "images": {
    "binding": "IMAGES"
  },
  // Custom domains and routes are managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
