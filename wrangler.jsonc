{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker selected by the Cloudflare Workers Build.
  "name": "runsit-ca",
  // Preserve runtime settings maintained in the Cloudflare dashboard.
  "keep_vars": true,
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "TEMPLATES_AI_ORDERS", "class_name": "TemplateAiOrder" }, { "name": "TEMPLATES_TRIAL_CODES", "class_name": "TemplateTrialCodes" }]
  },
  "migrations": [{ "tag": "templates-ai-v1", "new_sqlite_classes": ["TemplateAiOrder"] }, { "tag": "templates-trial-v1", "new_sqlite_classes": ["TemplateTrialCodes"] }],
  "d1_databases": [{
    "binding": "LOCAL_LORE_DB",
    "database_name": "local-lore",
    "database_id": "125038bb-ee87-415a-aa6a-f2d73ce93873",
    "migrations_dir": "migrations/local-lore"
  }],
  "vars": {
    "LOCAL_LORE_IMAGE_DAILY_LIMIT": "250",
    "TEMPLATES_AI_ENABLED": "true",
    "TEMPLATES_AI_MODEL": "gpt-6-luna",
    "TEMPLATES_AI_REASONING_EFFORT": "max",
    "TEMPLATES_TRIAL_ENABLED": "true",
    "TEMPLATES_ICON_ENABLED": "true",
    "TEMPLATES_ICON_MODEL": "gpt-image-2.5-flare-2026-09-08"
  },
  // Enable Next.js <Image> optimization on Cloudflare.
  "images": {
    "binding": "IMAGES"
  },
  // Custom domains and routes are managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
